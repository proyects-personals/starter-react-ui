{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@": ["./src/index.ts"],
      "@/*": ["./src/*"],
      "@aplicacion": ["./src/libs/aplicacion/index.ts"],
      "@aplicacion/*": ["./src/libs/aplicacion/*"],
      "@domain": ["./src/libs/domain/index.ts"],
      "@domain/*": ["./src/libs/domain/*"],
      "@infraestructura": ["./src/libs/infraestructura/index.ts"],
      "@infraestructura/*": ["./src/libs/infraestructura/*"],
      "@presentation": ["./src/libs/presentation/index.ts"],
      "@presentation/*": ["./src/libs/presentation/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/libs/styles/*"]
    }
  },
  "include": ["src"]
}
